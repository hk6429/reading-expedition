{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "sourceItem",
    "factPack",
    "contentKey",
    "packages"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseUrl",
        "licenseType",
        "licenseVersion",
        "allowedUsage"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "baseUrl": { "type": "string" },
        "licenseType": { "type": "string" },
        "licenseVersion": { "type": ["string", "null"] },
        "allowedUsage": {
          "type": "string",
          "const": "facts-and-short-extracts"
        }
      }
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonicalUrl",
        "title",
        "publisher",
        "publishedAt",
        "fetchedAt",
        "contentFingerprint",
        "licenseSnapshot",
        "extractScope"
      ],
      "properties": {
        "id": { "type": "string" },
        "canonicalUrl": { "type": "string" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "publishedAt": { "type": ["string", "null"] },
        "fetchedAt": { "type": "string" },
        "contentFingerprint": { "type": "string" },
        "licenseSnapshot": { "type": "string" },
        "extractScope": { "type": "string" }
      }
    },
    "factPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicDate",
        "category",
        "facts",
        "sourceLinks",
        "sensitivityFlags",
        "verificationStatus",
        "version"
      ],
      "properties": {
        "id": { "type": "string" },
        "topicDate": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["world", "science", "humanities"]
        },
        "facts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "sourceItemId"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "sourceItemId": { "type": "string" }
            }
          }
        },
        "sourceLinks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "sensitivityFlags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verificationStatus": {
          "type": "string",
          "const": "verified"
        },
        "version": { "type": "integer", "const": 1 }
      }
    },
    "contentKey": { "type": "string" },
    "packages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "difficulty",
          "textType",
          "title",
          "hookQuestion",
          "body",
          "glossary",
          "readingMinutes",
          "sourceAttribution",
          "qualityScore",
          "hardGateStatus",
          "publicationStatus",
          "version",
          "assessment"
        ],
        "properties": {
          "id": { "type": "string" },
          "difficulty": {
            "type": "string",
            "enum": ["guided", "challenge"]
          },
          "textType": {
            "type": "string",
            "enum": ["vernacular", "classical"]
          },
          "title": { "type": "string" },
          "hookQuestion": { "type": "string" },
          "body": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": { "type": "string" }
          },
          "glossary": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "definition"],
              "properties": {
                "term": { "type": "string" },
                "definition": { "type": "string" }
              }
            }
          },
          "readingMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 15
          },
          "sourceAttribution": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["publisher", "url", "license"],
              "properties": {
                "publisher": { "type": "string" },
                "url": { "type": "string" },
                "license": { "type": "string" }
              }
            }
          },
          "qualityScore": {
            "type": "integer",
            "const": 100
          },
          "hardGateStatus": {
            "type": "string",
            "const": "passed"
          },
          "publicationStatus": {
            "type": "string",
            "const": "manual_review"
          },
          "version": { "type": "integer", "const": 1 },
          "assessment": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "prompt",
                "options",
                "correctAnswer",
                "rationale",
                "distractorReasons",
                "evidenceSpan"
              ],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["comprehension", "inference", "evidence"]
                },
                "prompt": { "type": "string" },
                "options": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "string" }
                },
                "correctAnswer": { "type": "string" },
                "rationale": { "type": "string" },
                "distractorReasons": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "evidenceSpan": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["paragraph", "start", "end", "text"],
                  "properties": {
                    "paragraph": { "type": "integer", "minimum": 1 },
                    "start": { "type": "integer", "minimum": 0 },
                    "end": { "type": "integer", "minimum": 1 },
                    "text": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
