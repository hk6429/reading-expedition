{
  "name": "reading-expedition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/domain/**/*.test.mjs\" \"test/storage/**/*.test.mjs\"",
    "test:api": "node --test \"test/api/**/*.test.mjs\"",
    "test:pipeline": "node --test \"test/pipeline/**/*.test.mjs\"",
    "test:static": "node --test \"test/static/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "content:new": "node scripts/generate-manual-content.mjs",
    "content:validate": "node scripts/validate-manual-content.mjs",
    "content:ready": "node scripts/validate-manual-content.mjs --require-count 30",
    "content:sql": "node scripts/render-manual-sql.mjs",
    "dev:web": "wrangler pages dev . --port 8788",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml --env=\"\"",
    "deploy:worker:preview": "wrangler deploy --config wrangler.worker.toml --env preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "wrangler": "^4.114.0"
  }
}
